.venv/
venv/
env/
ENV/

# Packaging and build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and type checker caches
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.tox/

# Coverage
.coverage*
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/

# Editor/IDE
.vscode/
.idea/
*.code-workspace

